# Public site switch: leave false during private device tests.
WHATSAPP_BRIDGE_ENABLED=false
WHATSAPP_SOUND_ENABLED=false
WHATSAPP_BRIDGE_URL=http://whatsapp-bridge:3001

# Private bot switches, mapped by docker-compose.whatsapp.yml.
WHATSAPP_BOT_ENABLED=false
WHATSAPP_BOT_SOUND_ENABLED=false

# Three INDEPENDENT secrets. Generate privately; never paste them into chat.
# TOKEN: at least 32 characters. TRANSFER_KEY / AUTH_KEY: 32 random bytes,
# encoded as unpadded base64url (43 characters). No real secret belongs here.
WHATSAPP_BRIDGE_TOKEN=
WHATSAPP_TRANSFER_KEY=
WHATSAPP_AUTH_KEY=

# International number in digits only: country code, no +, space or leading 0.
WHATSAPP_BOT_NUMBER=
